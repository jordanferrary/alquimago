{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alquimago",
  "version": "0.1.0",
  "identifier": "dev.jordanferrary.alquimago",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;" },
    "windows": [
      {
        "label": "main",
        "title": "Alquimago",
        "url": "desktop.html",
        "width": 340,
        "height": 460,
        "minWidth": 340,
        "minHeight": 460,
        "maxWidth": 340,
        "maxHeight": 460,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
